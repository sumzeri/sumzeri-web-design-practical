<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>CSS3 Showcase</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;color:#1a1a1a;background:#f5f5f3}
.hero{text-align:center;padding:4rem 2rem 3rem;background:#fff;border-bottom:1px solid #e8e8e8;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent,transparent 40px,rgba(55,138,221,.04) 40px,rgba(55,138,221,.04) 41px)}
.eyebrow{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#185FA5;background:#E6F1FB;border:1px solid #85B7EB;padding:5px 14px;border-radius:999px;margin-bottom:1.2rem;animation:rise .7s ease both}
h1{font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.4rem);line-height:1.15;animation:rise .7s .1s ease both}
h1 span{color:#378ADD}
.sub{font-size:1rem;color:#666;margin:1rem auto 2rem;max-width:480px;line-height:1.7;animation:rise .7s .2s ease both}
.pills{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;animation:rise .7s .3s ease both}
.pill{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:999px;font-size:12px;font-weight:500;border:1px solid}
.pb{background:#E6F1FB;color:#0C447C;border-color:#85B7EB}
.pt{background:#E1F5EE;color:#085041;border-color:#5DCAA5}
.pc{background:#FAECE7;color:#712B13;border-color:#F0997B}
.pp{background:#EEEDFE;color:#3C3489;border-color:#AFA9EC}
.wrap{max-width:860px;margin:0 auto;padding:2.5rem 1.5rem}
.label{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:#888;margin-bottom:1.5rem}
.label::after{content:'';flex:1;height:1px;background:#e8e8e8}
.col-grid{column-count:3;column-gap:1rem}
@media(max-width:580px){.col-grid{column-count:1}}
@media(max-width:780px) and (min-width:581px){.col-grid{column-count:2}}
.card{break-inside:avoid;background:#fff;border:1px solid #eee;border-radius:14px;padding:1.25rem;margin-bottom:1rem;transition:transform .25s,border-color .25s}
.card:hover{transform:translateY(-5px) scale(1.01);border-color:#ccc}
.ico-wrap{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:.85rem;font-size:16px}
.ib{background:#E6F1FB;color:#185FA5}.it{background:#E1F5EE;color:#0F6E56}
.ic{background:#FAECE7;color:#993C1D}.ip{background:#EEEDFE;color:#534AB7}
.ia{background:#FAEEDA;color:#854F0B}.ik{background:#FBEAF0;color:#993556}
.card h3{font-size:.9rem;font-weight:600;margin-bottom:.3rem}
.card p{font-size:.8rem;color:#777;line-height:1.55}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#e8e8e8;border-radius:14px;overflow:hidden;border:1px solid #e8e8e8}
.stat{background:#fff;padding:1.4rem 1rem;text-align:center}
.stat .num{font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;animation:popIn .6s ease both}
.stat .lbl{font-size:.73rem;color:#888;margin-top:3px;font-weight:500}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:.8rem}
.acard{background:#fff;border:1px solid #eee;border-radius:14px;padding:1.2rem .8rem;text-align:center}
.acard .i{font-size:26px;display:inline-block;margin-bottom:.5rem}
.acard span{display:block;font-size:.72rem;font-weight:500;color:#999}
.spin{animation:spin 3s linear infinite;color:#378ADD}
.pulse{animation:pulse 1.4s ease-in-out infinite;color:#1D9E75}
.bounce{animation:bounce .9s ease-in-out infinite alternate;color:#D85A30}
.shake{animation:shake 1.4s ease-in-out infinite;color:#7F77DD}
.flip3d{animation:flip 2.2s ease-in-out infinite;color:#D4537E}
.swing{animation:swing 1.6s ease-in-out infinite;color:#BA7517;transform-origin:top center}
.tcard{background:#fff;border:1px solid #eee;border-radius:14px;padding:1.2rem .8rem;text-align:center}
.tcard .i{font-size:24px;color:#378ADD;display:block;margin-bottom:.5rem;transition:transform .4s cubic-bezier(.34,1.56,.64,1)}
.tcard:nth-child(1) .i:hover{transform:rotate(135deg)}
.tcard:nth-child(2) .i:hover{transform:scaleX(-1) scaleY(1.2)}
.tcard:nth-child(3) .i:hover{transform:skewX(-20deg)}
.tcard:nth-child(4) .i:hover{transform:scale(1.6)}
.tcard:nth-child(5) .i:hover{transform:perspective(300px) rotateY(40deg)}
.tcard:nth-child(6) .i:hover{transform:translateY(-10px) rotate(15deg)}
.tcard span{display:block;font-size:.72rem;font-weight:500;color:#999}
.div{height:1px;background:#e8e8e8;margin:1.5rem 0}
@keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
@keyframes bounce{from{transform:translateY(0)}to{transform:translateY(-12px)}}
@keyframes shake{0%,100%{transform:rotate(0)}25%{transform:rotate(-8deg)}75%{transform:rotate(8deg)}}
@keyframes flip{0%,100%{transform:rotateY(0)}50%{transform:rotateY(180deg)}}
@keyframes swing{0%,100%{transform:rotate(-12deg)}50%{transform:rotate(12deg)}}
@keyframes popIn{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:scale(1)}}
</style>
</head>
<body>
<div class="hero">
  <div class="eyebrow"><i class="fa fa-code"></i> CSS3 Feature Showcase</div>
  <h1>Build <span>beautiful</span><br>web experiences</h1>
  <p class="sub">A single-file demo of everything modern CSS3 offers — columns, fonts, icons, animations, and transforms.</p>
  <div class="pills">
    <span class="pill pb"><i class="fa fa-columns"></i> Multi-column</span>
    <span class="pill pt"><i class="fa fa-font"></i> Google Fonts</span>
    <span class="pill pc"><i class="fa fa-wand-magic-sparkles"></i> Animations</span>
    <span class="pill pp"><i class="fa fa-rotate"></i> Transforms</span>
  </div>
</div>

<div class="wrap">
  <div class="label"><i class="fa fa-layer-group"></i> CSS multi-column layout</div>
  <div class="col-grid">
    <div class="card"><div class="ico-wrap ib"><i class="fa fa-bolt"></i></div><h3>Performance</h3><p>GPU-accelerated transitions for silky-smooth 60fps rendering.</p></div>
    <div class="card"><div class="ico-wrap it"><i class="fa fa-mobile-screen"></i></div><h3>Responsive</h3><p>Fluid layouts that adapt from mobile to ultrawide screens.</p></div>
    <div class="card"><div class="ico-wrap ic"><i class="fa fa-palette"></i></div><h3>Design system</h3><p>Consistent tokens — spacing, radius, color — baked in.</p></div>
    <div class="card"><div class="ico-wrap ip"><i class="fa fa-lock"></i></div><h3>Accessible</h3><p>Keyboard navigable with semantic roles and ARIA labels.</p></div>
    <div class="card"><div class="ico-wrap ia"><i class="fa fa-star"></i></div><h3>Typography</h3><p>Playfair Display headings with Inter for crisp body copy.</p></div>
    <div class="card"><div class="ico-wrap ik"><i class="fa fa-cloud"></i></div><h3>Scalable</h3><p>Modular components that grow with any project size.</p></div>
  </div>
  <div class="div"></div>

  <div class="label"><i class="fa fa-chart-simple"></i> Animated metrics</div>
  <div class="stats">
    <div class="stat"><div class="num">98%</div><div class="lbl">Lighthouse score</div></div>
    <div class="stat"><div class="num">6</div><div class="lbl">@keyframes</div></div>
    <div class="stat"><div class="num">3</div><div class="lbl">Font weights</div></div>
    <div class="stat"><div class="num">∞</div><div class="lbl">Possibilities</div></div>
  </div>
  <div class="div"></div>

  <div class="label"><i class="fa fa-wand-magic-sparkles"></i> CSS animations</div>
  <div class="grid">
    <div class="acard"><i class="fa fa-gear i spin"></i><span>spin</span></div>
    <div class="acard"><i class="fa fa-heart i pulse"></i><span>pulse</span></div>
    <div class="acard"><i class="fa fa-arrow-up i bounce"></i><span>bounce</span></div>
    <div class="acard"><i class="fa fa-bell i shake"></i><span>shake</span></div>
    <div class="acard"><i class="fa fa-id-card i flip3d"></i><span>3D flip</span></div>
    <div class="acard"><i class="fa fa-anchor i swing"></i><span>swing</span></div>
  </div>
  <div class="div"></div>

  <div class="label"><i class="fa fa-arrows-rotate"></i> CSS transforms — hover each</div>
  <div class="grid">
    <div class="tcard"><i class="fa fa-star i"></i><span>rotate</span></div>
    <div class="tcard"><i class="fa fa-fish i"></i><span>scaleX flip</span></div>
    <div class="tcard"><i class="fa fa-square i"></i><span>skew</span></div>
    <div class="tcard"><i class="fa fa-circle i"></i><span>scale</span></div>
    <div class="tcard"><i class="fa fa-cube i"></i><span>perspective</span></div>
    <div class="tcard"><i class="fa fa-rocket i"></i><span>translate + rotate</span></div>
  </div>
</div>
</body>
</html>
