<title>Tribute Page</title>
<style>
body {
    margin: 0;
    font-family: Arial;
    background: linear-gradient(135deg, #1d2b64, #f8cdda);
    color: #333;
}
nav {
    background: rgba(0,0,0,0.7);
    padding: 12px;
    text-align: center;
}
nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
}
nav a:hover { color: #f8cdda; }

.container {
    width: 80%;
    margin: 40px auto;
    background: rgba(255,255,255,0.9);
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
}
h1, h2 {
    text-align: center;
}
img {
    display: block;
    margin: 15px auto;
    width: 200px;
    border-radius: 50%;
    border: 3px solid #1d2b64;
}
p {
    text-align: justify;
    line-height: 1.5;
}
footer {
    text-align: center;
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 8px;
}
